# TARGET config LiBwrt‑25.12‑nss 京东云亚瑟 jdcloud_re‑ss‑01
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
# !!!!! LiBwrt必须关闭MULTI_PROFILE，开启会输出generic镜像刷机无法启动
# CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01="ipq-wifi-jdcloud_re-ss-01 -kmod-ath11k-pci zram-swap luci-app-cupsd"

CONFIG_TARGET_ROOTFS_INITRAMFS=n
CONFIG_PACKAGE_zram-swap=y

# Kernel modules
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tls=y
CONFIG_PACKAGE_kmod-tun=y

# ========= USB完整栈，LiBwrt内核已经开启CONFIG_USB_PRINTER =========
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y

# USB打印模块
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y

# U盘/移动硬盘支持
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# ========= 仅保留 F2FS + EXT4，移除exfat/vfat/ntfs3 =========
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y

CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y

# 磁盘挂载工具
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y

# Samba轻量版，不带LuCI网页配置界面
CONFIG_PACKAGE_samba4-server-mini=y
CONFIG_PACKAGE_luci-app-samba4=n

# ====================== LuCI完整基础依赖【25.12必须使用ucode‑mod‑math，废弃luci‑lib‑math】 ======================
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-uci=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-diskman=y

# 命令行工具
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_vi-full=y
CONFIG_PACKAGE_nano=n
CONFIG_PACKAGE_nano-full=n

# 彻底禁用包管理器，固件不可在线安装
CONFIG_PACKAGE_opkg=n
CONFIG_PACKAGE_apk=n

# dockerd仅编译二进制，开机自启控制后续通过patch脚本处理
CONFIG_PACKAGE_dockerd=y

# ========= 覆盖关闭 compile_base.config / 片段带入全部多余软件包 =========
CONFIG_PACKAGE_coremark=n
CONFIG_PACKAGE_proto-bonding=n
CONFIG_PACKAGE_luci-proto-wireguard=n
CONFIG_PACKAGE_luci-proto-relay=n
CONFIG_PACKAGE_easytier=n
CONFIG_PACKAGE_luci-app-easytier=n
CONFIG_PACKAGE_luci-app-istorex=n
CONFIG_PACKAGE_luci-app-lucky=n
CONFIG_PACKAGE_luci-app-mosdns=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-pbr=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-wol=n

CONFIG_PACKAGE_luci-theme-argon=n
CONFIG_PACKAGE_luci-theme-aurora=n
CONFIG_PACKAGE_luci-app-argon-config=n
CONFIG_PACKAGE_luci-app-aurora-config=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-autoreboot=n
CONFIG_PACKAGE_luci-app-cpufreq=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_luci-app-banip=n
CONFIG_PACKAGE_luci-app-usb-printer=n
CONFIG_PACKAGE_luci-app-athena-led=n
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=n

CONFIG_PACKAGE_htop=n
CONFIG_PACKAGE_tcpdump=n
CONFIG_PACKAGE_sgdisk=n
CONFIG_PACKAGE_openssl-util=n
CONFIG_PACKAGE_resize2fs=n
CONFIG_PACKAGE_qrencode=n
CONFIG_PACKAGE_smartmontools-drivedb=n
CONFIG_PACKAGE_usbmuxd=n
CONFIG_PACKAGE_mii-tool=n
CONFIG_PACKAGE_xl2tpd=n
CONFIG_PACKAGE_xz-utils=n
CONFIG_PACKAGE_nginx-full=n
CONFIG_PACKAGE_logrotate=n
